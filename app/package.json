{
  "name": "slack-water-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Slack Water: tide tables PWA. Vanilla TypeScript + Custom Elements.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/size-budget.mjs",
    "stations": "node scripts/build-stations.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run size && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
